<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FastFood.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FastFood.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-page="/Index">
                    فست‌فود
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="باز کردن منو">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Index">
                                خانه
                            </a>
                        </li>

                        <a class="nav-link" asp-page="/Menu">
                            منوی غذا                    
                        </a>

                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/MyOrders">
                                    سفارش‌های من
                                </a>
                            </li>
                        }

                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Admin/Orders">
                                    مدیریت سفارش‌ها
                                </a>
                            </li>
                        }


                    </ul>

                    
                    <div class="d-flex align-items-center gap-2">

                        <a asp-page="/Cart" class="btn btn-warning">
                            🛒 سبد خرید
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-light">
                                خوش آمدی، @User.Identity.Name
                            </span>

                            <form method="post" asp-page="/Logout" class="m-0">
                                <button type="submit" class="btn btn-outline-light">
                                    خروج
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-page="/Login" class="btn btn-outline-light">
                                ورود
                            </a>
                        }

                    </div>


                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FastFood.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>