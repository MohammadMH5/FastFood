@page
@model FastFood.Web.Pages.OrderDetailsModel

@{
    ViewData["Title"] = "جزئیات سفارش";
}

<section class="container py-5" dir="rtl">
    <h2 class="mb-4">📦 جزئیات سفارش</h2>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>

        <a asp-page="/MyOrders" class="btn btn-secondary">
            بازگشت به سفارش‌های من
        </a>
    }
    else if (Model.Order != null)
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <h5>سفارش شماره #@Model.Order.Id</h5>

                    <span class="badge bg-secondary">
                        @Model.Order.Status
                    </span>
                </div>

                <hr />

                <h5 class="mb-3">محصولات سفارش</h5>

                @foreach (var item in Model.Order.Items)
                {
                    <div class="d-flex justify-content-between align-items-center border-bottom py-3 gap-3">
                        <div>
                            <div class="fw-bold">
                                @item.ProductName
                            </div>

                            <small class="text-muted">
                                تعداد: @item.Quantity
                            </small>
                        </div>

                        <div class="text-nowrap">
                            @((item.UnitPrice * item.Quantity).ToString("N0"))
                            تومان
                        </div>
                    </div>
                }

                <div class="text-end mt-4">
                    <h5>
                        مبلغ کل:
                        <span class="text-success">
                            @Model.Order.TotalPrice.ToString("N0") تومان
                        </span>
                    </h5>
                </div>

                <a asp-page="/MyOrders"
                   class="btn btn-outline-secondary mt-3">
                    بازگشت به سفارش‌های من
                </a>

            </div>
        </div>
    }
</section>
